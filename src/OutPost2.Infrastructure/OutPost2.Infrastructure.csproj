<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OutPost2.Core\OutPost2.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.7" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- The data protection key ring lives in Postgres rather than the container
         filesystem (OP2-56). Without it the ring is regenerated on every start, so every
         deploy invalidates every auth cookie and every in-flight antiforgery token. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Graph" Version="6.9.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Design-time only: carries IDesignTimeDbContextFactory so `dotnet ef` can build a
         context without starting the web host. PrivateAssets keeps it out of anything
         that references this project, and out of the shipped image. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="VaultSharp" Version="1.17.5.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
