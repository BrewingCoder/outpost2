{
  "DetailedErrors": true,

  // Running straight from the repo on one machine: apply the schema on boot. The deployed
  // container asks for this separately rather than inheriting it from the environment.
  "OutPost2": { "MigrateOnBoot": true },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  }
}