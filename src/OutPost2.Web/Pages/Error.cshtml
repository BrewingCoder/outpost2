@page
@using OutPost2.Web.Pages
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

@*
    The scaffold's version of this page lectured the reader about ASPNETCORE_ENVIRONMENT,
    which is advice for whoever deployed it, not for whoever hit the error. The one piece
    of information worth showing a user is the request id, because that is the only thing
    that connects what they saw to a line in the log.
*@

<div class="op-pagehead">
    <div>
        <h1 class="op-h1">Something went wrong</h1>
        <p class="op-lede">
            Outpost could not finish that. Nothing was changed by the request that failed.
        </p>
    </div>
</div>

@if (Model.ShowRequestId)
{
    <div class="op-panel">
        <p class="op-muted" style="margin:0">
            If you need to report this, quote the request id. It is the only thing that
            ties what you saw to a line in the log.
        </p>
        <div class="op-row">
            <code class="op-mono" id="reqid">@Model.RequestId</code>
            <button class="op-btn op-btn--secondary op-btn--sm" type="button"
                    data-copy="@Model.RequestId" data-copy-field="reqid">
                @Icons.Copy()<span data-copy-label>Copy</span>
            </button>
        </div>
    </div>
}

<div class="op-row">
    <a class="op-btn op-btn--primary" href="/">Back to Outpost</a>
    <a class="op-btn op-btn--secondary" asp-page="/Connections">Connections</a>
</div>

@section Scripts {
    <script src="~/js/outpost.js" asp-append-version="true"></script>
}
