@page "/files"
@using OutPost2.Web.Auth
@using OutPost2.Web.Pages
@model FilesModel
@{
    ViewData["Title"] = "Files";
    var readOnly = User.IsPreview();
}

<div class="op-pagehead">
    <div>
        <h1 class="op-h1">Files</h1>
        <p class="op-lede">
            Upload here, then refer to a file by its name in conversation: &ldquo;attach the
            signed contract&rdquo;. You name it now, while you have a screen, so you never
            have to spell anything out later.
        </p>
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="op-note op-note--warn" role="alert">@Icons.Warn()<span>@Model.Error</span></div>
}
@if (Model.Added is not null)
{
    <div class="op-note op-note--info" role="status">
        @Icons.Check()<span>Uploaded <b class="op-mono">@Model.Added</b>.</span>
    </div>
}

@if (!readOnly)
{
    <section class="op-panel" aria-label="Upload">
        <form method="post" action="/files/upload" enctype="multipart/form-data" class="op-grid2">
            @Html.AntiForgeryToken()
            <div class="op-field">
                <label class="op-field__label" for="file">File</label>
                <input class="op-input" type="file" id="file" name="file" required style="padding-top:9px" />
            </div>
            <div class="op-field">
                <label class="op-field__label" for="name">Call it</label>
                <input class="op-input" id="name" name="name" maxlength="200" autocomplete="off"
                       placeholder="signed contract" />
                <span class="op-field__help">The name you&rsquo;ll say. Leave blank to use the filename.</span>
            </div>
            <div class="op-row op-row--end" style="grid-column:1/-1">
                <button class="op-btn op-btn--primary">Upload</button>
            </div>
        </form>
    </section>
}

<section class="op-group" aria-labelledby="h-staged">
    <div class="op-group__head">
        <h2 class="op-h2" id="h-staged">Staged</h2>
        <span class="op-count">@(Model.Files.Count == 1 ? "1 file" : $"{Model.Files.Count} files")</span>
    </div>

    @if (Model.Files.Count == 0)
    {
        <div class="op-panel"><p class="op-muted" style="margin:0">Nothing staged.</p></div>
    }
    else
    {
        <div class="op-panel">
            <ul class="op-list">
                @foreach (var f in Model.Files)
                {
                    <li>
                        <span class="op-grow">
                            <b class="op-mono">@f.Name</b>
                            <span class="op-field__help">
                                @f.FileName &middot; @f.HumanSize &middot; uploaded @FilesModel.Ago(f.UploadedAt)
                            </span>
                        </span>
                        <span class="op-muted" style="font-size:13px">
                            expires @f.ExpiresAt.ToLocalTime().ToString("d MMM HH:mm")
                        </span>
                        @if (!readOnly)
                        {
                            <a class="op-btn op-btn--secondary op-btn--sm" href="/files/@f.Id/download">Download</a>
                            <form method="post" action="/files/@f.Id/delete"
                                  data-confirm-submit="Delete @f.Name? Anything referring to it by name stops working.">
                                @Html.AntiForgeryToken()
                                <button class="op-btn op-btn--danger op-btn--sm">Delete</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/outpost.js" asp-append-version="true"></script>
}
