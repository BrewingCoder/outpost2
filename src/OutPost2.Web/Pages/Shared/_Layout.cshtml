@using System.Security.Claims
@using OutPost2.Core.Jobs
@using OutPost2.Infrastructure.Jobs
@using OutPost2.Web.Auth
@using OutPost2.Web.Connections
@inject IJobService Jobs
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isPreview = signedIn && User.IsPreview();
    var login = User.FindFirst(ClaimTypes.Name)?.Value;

    // The badge has to be right on every page, so it is counted here rather than left to
    // each page to remember. Cheap: one indexed query against a table that stays small.
    var waiting = 0;
    if (signedIn)
    {
        var all = await Jobs.ListAsync(User.UserId());
        waiting = all.Count(j => j.State == JobState.AwaitingApproval);
    }

    var page = (ViewContext.RouteData.Values["page"] as string ?? "").ToLowerInvariant();
    string Current(string p) => page == p ? "page" : null!;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; Outpost</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/outpost.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
<div class="op-app">
@if (signedIn)
{
    <header class="op-top">
        <a class="op-brand" asp-page="/Index">
            <partial name="_Mark" />Outpost
        </a>
        <nav class="op-nav" aria-label="Main">
            <a asp-page="/Index" aria-current="@Current("/index")">Home</a>
            <a asp-page="/Connections" aria-current="@Current("/connections")">Connections</a>
            @* The @@if must not butt up against the preceding text: Razor only treats it
               as a transition at the start of a markup node, so "Approvals@@if" renders
               the literal source. Wrapping the word in its own element fixes it. *@
            <a asp-page="/Jobs" aria-current="@Current("/jobs")">
                <span>Approvals</span>
                @if (waiting > 0)
                {
                    <span class="op-badge">@waiting</span>
                }
            </a>
            <a asp-page="/Files" aria-current="@Current("/files")">Files</a>
            <a asp-page="/RepoNames" aria-current="@Current("/reponames")">Repository names</a>
            <a asp-page="/PreviewLinks" aria-current="@Current("/previewlinks")">Preview links</a>
        </nav>
        <span class="op-me"><span>Signed in as</span> <b>@login</b></span>
    </header>
    @if (isPreview)
    {
        <div class="op-preview-bar" role="status">
            @Icons.Lock()
            <span><strong>Preview session.</strong> You can look at every page. Nothing here can be changed.</span>
        </div>
    }
}
<main class="op-page">
    @RenderBody()

    @if (signedIn)
    {
        <footer class="op-row op-muted" style="font-size:14px;border-top:1px solid var(--rule);padding-top:16px">
            <a asp-page="/Privacy">What Outpost holds</a>
            <span class="op-grow"></span>
            @if (!isPreview)
            {
                <form method="post" action="/signout">
                    @Html.AntiForgeryToken()
                    <button class="op-btn op-btn--quiet op-btn--sm">Sign out</button>
                </form>
            }
        </footer>
    }
</main>
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
