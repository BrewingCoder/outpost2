@page
@using OutPost2.Core.Connections
@using OutPost2.Web.Pages
@model ConnectionsModel
@{
    ViewData["Title"] = "Connections";
}

<div class="op-pagehead">
    <div>
        <h1 class="op-h1">Connections</h1>
        <p class="op-lede">
            Each connection is one account with a name you say out loud. Claude routes your
            request by that name.
        </p>
    </div>
    <button class="op-btn op-btn--primary" type="button" data-open="dlg-add">@Icons.Plus() Add connection</button>
</div>

@if (Model.Error is not null)
{
    <div class="op-note op-note--warn" role="alert">@Icons.Warn()<span>@Model.Error</span></div>
}
@if (Model.Added is not null)
{
    <div class="op-note op-note--info" role="status">
        @Icons.Check()<span>Connected <b class="op-mono">@Model.Added</b>. Say its name to use it.</span>
    </div>
}
@if (Model.Replaced is not null)
{
    <div class="op-note op-note--info" role="status">
        @Icons.Check()<span>New token stored for <b class="op-mono">@Model.Replaced</b>.</span>
    </div>
}

<section class="op-legend" aria-label="How to read this page">
    <div class="op-legend__item">
        @Icons.Mic()
        <span><strong>The name is the command</strong>Say &ldquo;check <b class="op-mono">work</b> email&rdquo; and Claude uses <b class="op-mono">work</b>.</span>
    </div>
    <div class="op-legend__item" style="color: var(--enforced);">
        @Icons.Lock()
        <span><strong>Lock: enforced</strong><span style="color: var(--ink-muted);">The provider blocks anything switched off.</span></span>
    </div>
    <div class="op-legend__item" style="color: var(--honor);">
        @Icons.Unlock()
        <span><strong>Open lock: honor system</strong><span style="color: var(--ink-muted);">The token can do more. Outpost just won&rsquo;t.</span></span>
    </div>
</section>

@foreach (var g in Model.Groups)
{
    var gid = "g-" + g.Provider.ToString().ToLowerInvariant();
    <section class="op-group" aria-labelledby="@gid">
        <div class="op-group__head">
            <h2 class="op-h2" id="@gid">@g.Heading</h2>
            <span class="op-count">@(g.Connections.Count == 1 ? "1 connection" : $"{g.Connections.Count} connections")</span>
        </div>

        @if (g.Connections.Count == 0)
        {
            <div class="op-rule"><span class="op-rule__why" style="flex-basis:auto">Nothing connected yet.</span></div>
        }
        else
        {
            <div class="op-rule">
                <span class="op-rule__label">Unnamed requests</span>
                @if (g.Default is not null)
                {
                    <span class="op-rule__value">@Icons.Arrow() go to <span class="op-callsign--inline">@g.Default.Label</span></span>
                }
                else
                {
                    <span class="op-rule__value">@Icons.Ask() Claude asks which one</span>
                }
                <button class="op-btn op-btn--quiet op-btn--sm" type="button" data-open="dlg-default-@g.Provider">Change</button>
                @if (g.NoDefaultReason is not null)
                {
                    <span class="op-rule__why">@g.NoDefaultReason</span>
                }
            </div>

            @foreach (var c in g.Connections)
            {
                <article class="op-channel" aria-label="Connection @c.Label">
                    <div class="op-channel__head">
                        <div class="op-channel__who">
                            <span class="op-callsign">@c.Label</span>
                            <span class="op-say">
                                @Icons.Mic() Say <q>@Html.Raw(ConnectionsModel.SpokenExampleHtml(c))</q>
                            </span>
                        </div>
                        <span class="op-tag op-tag--@ConnectionsModel.StatusClass(c.State)">
                            @if (c.State is ConnectionState.Active or ConnectionState.Consented)
                            {
                                <span class="op-live" aria-hidden="true"></span>
                            }
                            @ConnectionsModel.StatusWord(c.State)
                        </span>
                    </div>

                    <div class="op-channel__acct">
                        @ConnectionsModel.AccountLine(c)
                        @if (ConnectionsModel.TenantShort(c) is { } tenant)
                        {
                            <text>&middot; tenant <code>@tenant</code></text>
                        }
                    </div>

                    @if (ConnectionsModel.Alert(c) is { } a)
                    {
                        <div class="op-channel__alert op-channel__alert--@ConnectionsModel.StatusClass(c.State)">
                            @Icons.Clock()
                            <span>@a.Text</span>
                            @if (c.AuthKind == AuthKind.PersonalAccessToken)
                            {
                                <button class="op-btn op-btn--primary op-btn--sm" type="button" data-open="dlg-replace-@c.Id">@a.Action</button>
                            }
                            else
                            {
                                <form method="post" action="/connections/microsoft/start">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="label" value="@c.Label" />
                                    <button class="op-btn op-btn--primary op-btn--sm">@a.Action</button>
                                </form>
                            }
                        </div>
                    }

                    @foreach (var band in ConnectionsModel.CapabilityBands(c))
                    {
                        var honor = band.Key;
                        <div class="op-caps @(honor ? "op-caps--honor" : "op-caps--enforced")">
                            <div class="op-caps__band">
                                @(honor ? Icons.Unlock() : Icons.Lock())
                                @if (honor)
                                {
                                    <span><strong>Honor system.</strong> This token can do everything below even when it&rsquo;s off. The switches are your promise, not a lock.</span>
                                }
                                else
                                {
                                    <span><strong>Enforced by @c.Provider.</strong> Switching off removes the permission from the sign-in.</span>
                                }
                            </div>

                            @foreach (var cap in band)
                            {
                                <div class="op-cap @(cap.Granted ? "" : "op-cap--na")">
                                    <span class="op-cap__text">
                                        <span class="op-cap__verb">
                                            @CapabilityCatalog.Verb(cap.Name)
                                            @if (CapabilityCatalog.RiskLabel(cap.Name) is { } risk)
                                            {
                                                <span class="op-cap__risk">@risk</span>
                                            }
                                        </span>
                                        <span class="op-cap__scope">@cap.Name</span>
                                    </span>
                                    @if (!cap.Granted)
                                    {
                                        <span class="op-cap__na">Not granted by this token</span>
                                    }
                                    else
                                    {
                                        <form method="post" action="/connections/@c.Id/capability">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="capability" value="@cap.Name" />
                                            <input type="hidden" name="enabled" value="@((!cap.Enabled).ToString().ToLowerInvariant())" />
                                            <button class="op-switch" type="submit" role="switch"
                                                    aria-checked="@cap.Enabled.ToString().ToLowerInvariant()"
                                                    aria-label="@CapabilityCatalog.Verb(cap.Name)"
                                                    data-confirm="@ConnectionsModel.EnableConfirm(c, cap)"></button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="op-channel__meta">
                        <span>Connected @c.AddedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                        @if (c.LastUsedAt is { } used)
                        {
                            <span>Last used @ConnectionsModel.Ago(used)</span>
                        }
                        else
                        {
                            <span>Not used yet</span>
                        }
                        @if (ConnectionsModel.Lifetime(c) is { } life)
                        {
                            <span>@life</span>
                        }
                    </div>

                    <div class="op-channel__foot">
                        <button class="op-btn op-btn--secondary op-btn--sm" type="button" data-open="dlg-rename-@c.Id">Rename</button>
                        @if (c.AuthKind == AuthKind.PersonalAccessToken)
                        {
                            <button class="op-btn op-btn--secondary op-btn--sm" type="button" data-open="dlg-replace-@c.Id">Replace token</button>
                        }
                        <form method="post" action="/connections/@c.Id/delete" data-confirm-submit="Remove @c.Label? Outpost loses access until you connect it again.">
                            @Html.AntiForgeryToken()
                            <button class="op-btn op-btn--danger op-btn--sm">Remove @c.Label</button>
                        </form>
                    </div>
                </article>

                @* ── per-connection dialogs ────────────────────────────── *@
                <dialog class="op-dialog" id="dlg-rename-@c.Id">
                    <form method="post" action="/connections/@c.Id/rename" class="op-sheet">
                        @Html.AntiForgeryToken()
                        <div class="op-sheet__head">
                            <h2 class="op-h2">Rename @c.Label</h2>
                            <button class="op-x" type="button" data-close aria-label="Close">@Icons.Close()</button>
                        </div>
                        <div class="op-field">
                            <label class="op-field__label" for="rn-@c.Id">New name</label>
                            <input class="op-input op-input--mono" id="rn-@c.Id" name="label" value="@c.Label"
                                   required maxlength="60" autocomplete="off" data-callsign data-say="@c.Provider" />
                            <span class="op-field__help">You&rsquo;ll say: <span data-say-preview></span></span>
                <span data-name-warning hidden></span>
                        </div>
                        <div class="op-row op-row--end">
                            <button class="op-btn op-btn--secondary" type="button" data-close>Cancel</button>
                            <button class="op-btn op-btn--primary">Rename</button>
                        </div>
                    </form>
                </dialog>

                @if (c.AuthKind == AuthKind.PersonalAccessToken)
                {
                    <dialog class="op-dialog" id="dlg-replace-@c.Id">
                        <form method="post" action="/connections/@c.Id/replace-token" class="op-sheet">
                            @Html.AntiForgeryToken()
                            <div class="op-sheet__head">
                                <h2 class="op-h2">Replace the token for @c.Label</h2>
                                <button class="op-x" type="button" data-close aria-label="Close">@Icons.Close()</button>
                            </div>
                            <p class="op-muted">
                                The name, the capability switches and anything referring to
                                <b class="op-mono">@c.Label</b> stay as they are. Only the credential changes.
                            </p>
                            <div class="op-field">
                                <label class="op-field__label" for="rt-@c.Id">New token</label>
                                <input class="op-input op-input--mono" id="rt-@c.Id" name="token" type="password"
                                       required autocomplete="off" placeholder="paste it here" />
                            </div>
                            <div class="op-note op-note--warn">
                                @Icons.Unlock()
                                <span>Outpost can&rsquo;t shrink a token. Whatever you paste is what it holds, and the switches above are its own restraint.</span>
                            </div>
                            <div class="op-row op-row--end">
                                <button class="op-btn op-btn--secondary" type="button" data-close>Cancel</button>
                                <button class="op-btn op-btn--primary">Store it</button>
                            </div>
                        </form>
                    </dialog>
                }
            }

            @* ── which connection answers an unnamed request ───────────── *@
            <dialog class="op-dialog" id="dlg-default-@g.Provider">
                <div class="op-sheet">
                    <div class="op-sheet__head">
                        <h2 class="op-h2">Unnamed requests for @g.Heading.ToLowerInvariant()</h2>
                        <button class="op-x" type="button" data-close aria-label="Close">@Icons.Close()</button>
                    </div>
                    <p class="op-muted">When you don&rsquo;t say a name, this is what happens.</p>

                    <div class="op-list">
                        @foreach (var c in g.Connections)
                        {
                            <form method="post" action="/connections/@c.Id/default" class="op-row" style="padding:12px 0">
                                @Html.AntiForgeryToken()
                                <span class="op-grow">
                                    <b class="op-mono">@c.Label</b>
                                    @if (c.IsDefaultForProvider)
                                    {
                                        <span class="op-tag op-tag--default" style="margin-left:8px">Current</span>
                                    }
                                </span>
                                <button class="op-btn op-btn--secondary op-btn--sm" @(c.IsDefaultForProvider ? "disabled" : "")>Use @c.Label</button>
                            </form>
                        }
                        <form method="post" action="/connections/@g.Connections[0].Id/undefault" class="op-row" style="padding:12px 0">
                            @Html.AntiForgeryToken()
                            <span class="op-grow">
                                <b>Claude asks which one</b>
                                @if (g.Default is null)
                                {
                                    <span class="op-tag op-tag--default" style="margin-left:8px">Current</span>
                                }
                                <span class="op-field__help">@CapabilityCatalog.NoDefaultReason(g.Provider)</span>
                            </span>
                            <button class="op-btn op-btn--secondary op-btn--sm" @(g.Default is null ? "disabled" : "")>Always ask</button>
                        </form>
                    </div>
                </div>
            </dialog>
        }
    </section>
}

<partial name="_AddConnection" model="Model.Groups" />

@section Scripts {
    <script src="~/js/outpost.js" asp-append-version="true"></script>
}
