@page "/connections"
@model OutPost2.Web.Pages.ConnectionsModel
@using OutPost2.Core.Connections
@{ ViewData["Title"] = "Connections"; }

<h1 class="display-6">Connections</h1>
<p class="text-muted">
    Each connection is one account on one service, with a name you choose.
    Say the name and OutPost2 knows which one you mean.
</p>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
@if (Model.Added is not null)
{
    <div class="alert alert-success">Connected <strong>@Model.Added</strong>.</div>
}

@if (Model.Connections.Count == 0)
{
    <div class="alert alert-light border">No connections yet. Add one below.</div>
}
else
{
    <table class="table align-middle">
        <thead>
        <tr>
            <th>Name</th><th>Service</th><th>Account</th><th>Status</th>
            <th>Capabilities</th><th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Connections)
        {
            <tr>
                <td>
                    <strong>@c.Label</strong>
                    @if (c.IsDefaultForProvider)
                    {
                        <span class="badge text-bg-secondary ms-1">default</span>
                    }
                </td>
                <td>@c.Provider</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(c.AccountIdentifier))
                    {
                        <div>@c.AccountIdentifier</div>
                    }
                    @if (c.Provider == ProviderKind.Microsoft)
                    {
                        @if (c.IsPersonalAccount)
                        {
                            <span class="badge text-bg-warning">personal account</span>
                            <div class="form-text">
                                A personal Microsoft account, not your organisation's.
                                The same address can exist as both.
                            </div>
                        }
                        else
                        {
                            <span class="badge text-bg-light">work or school</span>
                        }
                    }
                    <div class="form-text"><code>@c.Instance</code></div>
                </td>
                <td>
                    @switch (c.State)
                    {
                        case ConnectionState.Active:
                            <span class="badge text-bg-success">active</span>
                            break;
                        case ConnectionState.NeedsAdminApproval:
                            <span class="badge text-bg-warning">awaiting admin</span>
                            break;
                        case ConnectionState.Expired:
                            <span class="badge text-bg-warning">needs re-auth</span>
                            break;
                        case ConnectionState.Revoked:
                            <span class="badge text-bg-danger">revoked</span>
                            break;
                        default:
                            <span class="badge text-bg-light">@c.State</span>
                            break;
                    }
                </td>
                <td>
                    @foreach (var cap in c.Capabilities)
                    {
                        <form method="post" action="/connections/@c.Id/capability?capability=@cap.Name&enabled=@((!cap.Enabled).ToString().ToLower())" class="d-inline">
    @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm @(cap.Usable ? "btn-success" : "btn-outline-secondary") me-1"
                                    title="@(cap.Granted ? (cap.Enabled ? "On - click to switch off" : "Granted but off - click to switch on") : "Not granted. Reconnect to request it.")"
                                    @(cap.Granted ? "" : "disabled")>
                                @cap.Name @(cap.Usable ? "on" : "off")
                            </button>
                        </form>
                    }
                    @if (c.Capabilities.Any(x => !x.Granted))
                    {
                        <div class="form-text">Greyed-out capabilities were not granted. Reconnect to request them.</div>
                    }
                </td>
                <td class="text-nowrap">
                    @if (!c.IsDefaultForProvider)
                    {
                        <form method="post" action="/connections/@c.Id/default" class="d-inline">
    @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-primary">Make default</button>
                        </form>
                    }
                    <form method="post" action="/connections/@c.Id/delete" class="d-inline"
                          onsubmit="return confirm('Remove @c.Label? OutPost2 will lose access until you reconnect.');">
    @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<hr />

<h2 class="h5">Add a Microsoft account</h2>
<form method="post" action="/connections/microsoft/start" class="row g-2 align-items-end" style="max-width:40rem">
    @Html.AntiForgeryToken()
    <div class="col-sm-5">
        <label class="form-label" for="label">Name it</label>
        <input class="form-control" id="label" name="label" placeholder="work" required maxlength="60" />
        <div class="form-text">What you'll call it out loud: "check <em>work</em> email".</div>
    </div>
    <div class="col-sm-5">
        <label class="form-label" for="tenantHint">Tenant (optional)</label>
        <input class="form-control" id="tenantHint" name="tenantHint" placeholder="contoso.com or a tenant id" />
        <div class="form-text">
            Leave blank to pick an account at sign-in. <strong>Give a tenant</strong>
            (e.g. <code>contoso.com</code>) to force the work directory &mdash; a
            personal Microsoft account can share your work email address, and the picker
            shows both.
        </div>
    </div>
    <div class="col-sm-2">
        <button class="btn btn-primary w-100" type="submit">Connect</button>
    </div>
</form>

<hr />

<h2 class="h5">Add a YouTrack server</h2>
<form method="post" action="/connections/youtrack/add" class="row g-2 align-items-end" style="max-width:52rem">
    @Html.AntiForgeryToken()
    <div class="col-sm-3">
        <label class="form-label" for="ytlabel">Name it</label>
        <input class="form-control" id="ytlabel" name="label" placeholder="lab tickets" required maxlength="60" />
    </div>
    <div class="col-sm-4">
        <label class="form-label" for="baseUrl">Server</label>
        <input class="form-control" id="baseUrl" name="baseUrl" placeholder="yt.example.com" required />
    </div>
    <div class="col-sm-3">
        <label class="form-label" for="token">Permanent token</label>
        <input class="form-control" id="token" name="token" type="password" placeholder="perm-..." required
               autocomplete="off" />
    </div>
    <div class="col-sm-2">
        <button class="btn btn-primary w-100" type="submit">Connect</button>
    </div>
    <div class="col-12">
        <div class="form-text">
            The token is validated against the server before it is stored, then encrypted.
            OutPost2 cannot narrow what a token is allowed to do &mdash; whatever you paste,
            it holds. The capability switches above are our own restraint, not an enforced limit.
        </div>
    </div>
</form>
